# Choose exactly one deployment mode: portfolio or trading.
NEXT_PUBLIC_APP_MODE=portfolio
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Wallet UI. This identifier is public; create one at cloud.reown.com for your deployment.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Required only for authenticated trading-wallet persistence.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
JWT_SECRET=

# Required only for the explicitly enabled private execution path.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
